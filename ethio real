      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 14px 25px;
      border-radius: 8px;
      font-weight: bold;
      transition: .3s;
    }

    .btn-primary {
      background: #f5c542;
      color: #111;
    }

    .btn-primary:hover {
