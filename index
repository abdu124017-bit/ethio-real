<!DOCTYPE html>
<html lang="am">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>ETHIO REAL | የህንፃ መሳሪያዎች</title>

  <meta name="description"
        content="ETHIO REAL - የህንፃ መሳሪያዎች፣ የቧንቧ፣ የመታጠቢያ ቤት እና የኤሌክትሪክ እቃዎች አቅራቢ።">

  <meta name="keywords"
